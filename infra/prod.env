# Overrides layered on top of the repo-root .env for the containerised stack.
#
# .env is written for running the backend on the developer's machine, where the
# databases are reachable on localhost through published ports. Inside a
# container localhost is the container itself, so every host here is the compose
# service name on its internal port. Compose applies env_file entries in order,
# so keep this listed after ../.env -- secrets such as GROQ_API_KEY stay in .env
# and are not duplicated here.

APP_ENV=prod

DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687

# The local model fallback runs on the host, not in the stack; localhost inside
# the container is the container. Harmless if nothing is listening -- the
# gateway falls through to extractive answers.
OLLAMA_URL=http://host.docker.internal:11434

# Paths inside the image. STORAGE_ROOT is the mounted volume; the backend runs
# with cwd=/app/backend, so these resolve under /app.
CHROMA_PATH=../infra/chroma
STORAGE_ROOT=../infra/storage
HF_HOME=../ml/.cache

# nginx serves the app and proxies /api and /ws to the backend, so the browser
# only ever talks to its own origin.
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
VITE_API_BASE=

.env
.env.*
!.env.example
__pycache__/
*.pyc
node_modules/
# Matched with a leading ** since backend commands (see Makefile) run with
# cwd=backend, so these paths resolve as backend/ml/.cache, backend/infra/...
# at runtime rather than the repo-root paths a naive anchor would only catch.
**/ml/.cache/
**/infra/chroma/
**/infra/storage/
**/infra/corpus_cache/
dist/
*.db
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
openapi.json
coverage/
*.log
.DS_Store
infra/docker-compose.override.local.yml
